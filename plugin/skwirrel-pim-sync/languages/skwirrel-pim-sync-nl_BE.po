#: includes/class-skwirrel-wc-sync-admin-settings.php:2795
msgid "Can WordPress fire scheduled events?"
msgstr "Kan WordPress geplande taken uitvoeren?"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:2454
