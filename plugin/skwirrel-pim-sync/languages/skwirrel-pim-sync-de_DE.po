msgid "%1$s Manage your Skwirrel API token in %2$s."
msgstr "%1$s Verwalten Sie Ihr Skwirrel-API-Token unter %2$s."

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1436
msgid "Settings → Connectors"
msgstr "Einstellungen → Connectors"

#. translators: %s = URL to Skwirrel webservice page
#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1449
#, php-format
msgid "Create a static API token at %s."
msgstr "Erstellen Sie ein statisches API-Token unter %s."

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1458
msgid "Timeout (seconds)"
msgstr "Zeitüberschreitung (Sekunden)"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1462
msgid "Retries"
msgstr "Wiederholungen"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1466
msgid "Context ID"
msgstr "Kontext-ID"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1489
msgid ""
"Optional. Leave this empty unless Skwirrel told you otherwise — an empty "
"field uses the Skwirrel default context. Fill it in only if your Skwirrel "
"instance serves several shops and you need the content of one specific "
"context. Changing it re-imports your whole catalogue on the next "
"synchronisation."
msgstr ""
"Optional. Lassen Sie dieses Feld leer, sofern Skwirrel nichts anderes angibt "
"— ein leeres Feld verwendet den Standardkontext von Skwirrel. Füllen Sie es "
"nur aus, wenn Ihre Skwirrel-Instanz mehrere Shops bedient und Sie die "
"Inhalte eines bestimmten Kontexts benötigen. Eine Änderung importiert Ihren "
"gesamten Katalog bei der nächsten Synchronisierung erneut."

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1493
