#: includes/class-skwirrel-wc-sync-admin-dashboard.php:957
msgid "Product status handling"
msgstr "Produktstatus-Verarbeitung"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:958
msgid ""
"Choose the WooCommerce state for each Skwirrel product status. Statuses are "
"discovered automatically as they appear during a sync. \"Keep published\" "
"leaves the product visible, \"Draft\" hides it, and \"Trash\" moves it to "
"the trash."
msgstr ""
"Wählen Sie den WooCommerce-Status für jeden Skwirrel-Produktstatus. Status "
"werden automatisch erkannt, sobald sie während einer Synchronisierung "
"auftreten. \"Veröffentlicht lassen\" hält das Produkt sichtbar, \"Entwurf\" "
"blendet es aus und \"Papierkorb\" verschiebt es in den Papierkorb."

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:963
msgid "Keep published"
msgstr "Veröffentlicht lassen"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:964
msgid "Draft (hidden)"
msgstr "Entwurf (ausgeblendet)"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:965
msgid "Trash"
msgstr "Papierkorb"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:966
msgid "Deprecated (retire gradually)"
msgstr "Auslaufend (schrittweise entfernen)"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:974
msgid "No status set"
msgstr "Kein Status gesetzt"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:975
msgid "Removed / discontinued in Skwirrel"
msgstr "In Skwirrel entfernt / eingestellt"

#: includes/class-skwirrel-wc-sync-admin-dashboard.php:976
