msgstr " — trop court"

#. translators: 1: last full sync duration in minutes, 2: minimum interval in
#. hours
#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1449
#, php-format
msgid ""
"Your last full sync took ~%1$d min, so auto-syncs must be at least %2$d "
"hours apart (one full hour of rest between runs)."
msgstr ""
"Votre dernière synchronisation complète a duré ~%1$d min, les "
"synchronisations automatiques doivent donc être espacées d'au moins %2$d "
"heures (une heure complète de repos entre les exécutions)."

#. translators: %d: minimum interval in hours
#: includes/class-skwirrel-wc-sync-admin-dashboard.php:1456
#, php-format
msgid ""
"Auto-syncs must be at least %d hours apart until the first full sync has run "
"to measure its duration."
msgstr ""
"Les synchronisations automatiques doivent être espacées d'au moins %d heures "
"jusqu'à ce que la première synchronisation complète ait été exécutée pour "
"mesurer sa durée."

