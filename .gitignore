# wp-env bind-mount placeholders. .wp-env.json maps these repo-root files into
# wp-content/plugins/skwirrel-pim-sync/, which IS this directory, so Docker keeps
# recreating them here as empty files. The plugin has no dev tooling of its own —
# ignoring them also stops it being shipped by accident.
/plugin/skwirrel-pim-sync/composer.json
/plugin/skwirrel-pim-sync/composer.lock
/plugin/skwirrel-pim-sync/phpunit.xml.dist
/plugin/skwirrel-pim-sync/phpunit-integration.xml.dist
/plugin/skwirrel-pim-sync/phpstan.neon.dist
/plugin/skwirrel-pim-sync/.phpcs.xml.dist
/plugin/skwirrel-pim-sync/tests/
/plugin/skwirrel-pim-sync/vendor/

# Skwirrel ERP reference
skwirrel/
/mu-plugins/essec-skwirrel-specs.php
/.bmad-board
.bmad-board/tab-state.json
.bmad-board/session-history.json

# BMAD skill run artefacts. Skills write their plan and validation reports next to
# their own definition, so a run dirties the skill directory itself. These are the
# output of a run, not part of the skill — 25 of them were committed by accident in
# 2823b89 and removed again by the 6.11.0 update.
.claude/skills/**/workflow-plan*.md
.claude/skills/**/validation-report-20*.md
